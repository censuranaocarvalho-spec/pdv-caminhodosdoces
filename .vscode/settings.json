{
  "files.exclude": {
    "**/__pycache__": true,
    "**/.history": true,
    "build": true,
    "dist": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "build/**": true,
    "dist/**": true,
    ".history/**": true,
    "dados/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "build": true,
    "dist": true,
    ".history": true,
    "dados": true
  },
  "python.analysis.exclude": [
    "**/.venv",
    "build/**",
    "dist/**",
    ".history/**",
    "dados/**"
  ],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.languageServer": "Pylance",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
