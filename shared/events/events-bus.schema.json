{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemEventPayload",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "ORDER_CREATED",
        "ORDER_SIGNAL_PAID_50",
        "ORDER_DISPATCHED",
        "ORDER_DELIVERED",
        "ORDER_FULLY_PAID",
        "FEEDBACK_RECEIVED_PROMOTOR",
        "FEEDBACK_RECEIVED_DETRATOR",
        "ANVISA_CHECKLIST_FAILED",
        "OPT_OUT_REQUESTED"
      ]
    },
    "sourceModule": {
      "type": "string",
      "enum": ["core-orders", "integrations-hub", "finance-ledger", "crm-marketing", "compliance-governance"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  },
  "required": ["eventId", "eventType", "sourceModule", "timestamp", "payload"]
}
