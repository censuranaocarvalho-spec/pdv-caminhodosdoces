{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IFoodOrderPayload",
  "type": "object",
  "properties": {
    "ifoodOrderId": { "type": "string" },
    "merchantId": { "type": "string" },
    "customer": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "integer" },
          "unitPrice": { "type": "number" },
          "optionsPrice": { "type": "number" }
        },
        "required": ["id", "name", "quantity", "unitPrice"]
      }
    },
    "total": {
      "type": "object",
      "properties": {
        "subTotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "benefits": { "type": "number" },
        "orderAmount": { "type": "number" }
      },
      "required": ["subTotal", "deliveryFee", "orderAmount"]
    }
  },
  "required": ["ifoodOrderId", "merchantId", "customer", "items", "total"]
}
