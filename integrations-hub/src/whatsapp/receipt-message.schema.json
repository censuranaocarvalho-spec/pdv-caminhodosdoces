{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WhatsAppReceiptNotification",
  "type": "object",
  "properties": {
    "recipientPhone": { "type": "string" },
    "orderId": { "type": "string", "format": "uuid" },
    "customerName": { "type": "string" },
    "receiptUrl": { "type": "string", "format": "uri" },
    "paymentStatus": { "type": "string", "enum": ["PAGO_TOTAL", "SINAL_50_PARCIAL"] },
    "paidAmount": { "type": "number" },
    "pendingAmount": { "type": "number" },
    "sentAt": { "type": "string", "format": "date-time" }
  },
  "required": ["recipientPhone", "orderId", "customerName", "receiptUrl", "paymentStatus", "paidAmount", "sentAt"]
}
